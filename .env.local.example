# Copy to .env.local and fill in values.

# ---- Site / SEO ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SCHEDULE_CALL_URL=

# ---- Admin Studio (/admin) ----
# Required for the admin area to be reachable (middleware.js gate).
# ADMIN_SESSION_SECRET must be >= 32 characters.
ADMIN_PASSWORD=localdev
ADMIN_SESSION_SECRET=

# CMS draft/publish storage: Vercel's serverless functions have a read-only filesystem,
# so drafts and published content are stored in Vercel Blob when this is set. Leave blank
# for local dev (writes go straight to the repo filesystem instead). In Vercel, create a
# Blob store under Project > Storage and connect it to this project — Vercel adds this var
# for you automatically.
BLOB_READ_WRITE_TOKEN=

# ---- AI content assistant (Anthropic) ----
ANTHROPIC_API_KEY=

# ---- Email (contact form, careers form, newsletter) ----
RESEND_API_KEY=
RESEND_FROM=
CAREERS_APPLICATION_TO=
NEWSLETTER_NOTIFY_TO=
