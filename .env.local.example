# Copy to .env.local and fill in values.

# ---- Site / SEO ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SCHEDULE_CALL_URL=

# ---- Admin Studio (/admin) ----
# Required for the admin area to be reachable (middleware.js gate).
# ADMIN_SESSION_SECRET must be >= 32 characters.
ADMIN_PASSWORD=localdev
ADMIN_SESSION_SECRET=

# ---- Admin Studio publish (GitHub Contents API) ----
# Required in production (e.g. Vercel), where the deployed filesystem is read-only.
# Without GITHUB_TOKEN, "Publish" falls back to writing content/cms/**.json directly on
# disk, which only works in local dev. Token needs repo `contents: write` permission
# (a fine-grained PAT scoped to this repo, or a classic PAT with `repo` scope).
GITHUB_TOKEN=
GITHUB_OWNER=Development-gomo
GITHUB_REPO=GOMO-Studio
GITHUB_BRANCH=main

# ---- AI content assistant (Anthropic) ----
ANTHROPIC_API_KEY=

# ---- Email (contact form, careers form, newsletter) ----
RESEND_API_KEY=
RESEND_FROM=
CAREERS_APPLICATION_TO=
NEWSLETTER_NOTIFY_TO=
